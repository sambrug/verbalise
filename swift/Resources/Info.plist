<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>OpenWhisperSwift</string>
	<key>CFBundleIdentifier</key>
	<string>com.sambruggen.openwhisper</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Open Whisper</string>
	<key>CFBundleDisplayName</key>
	<string>Open Whisper</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>

	<!-- The icon is copied into Resources by build-app.sh; without this key
	     nothing points at it and Finder, the Dock and the app switcher all
	     show the generic placeholder instead. -->
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>

	<!-- Required by App Store Connect. Dictation is Productivity; the
	     alternative reading, Utilities, is where reviewers expect system
	     tweaks rather than an app with a user-facing purpose (APP_STORE.md
	     section 7 is about not looking like the latter). -->
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>

	<!-- Declared here so the export-compliance question is not asked on every
	     submission. True: the app uses no encryption beyond HTTPS for model
	     downloads, which is exempt. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- Menu bar accessory: no Dock icon, no main window. -->
	<key>LSUIElement</key>
	<true/>

	<key>NSMicrophoneUsageDescription</key>
	<string>Open Whisper records audio from your microphone while you hold the trigger key, and transcribes it on this Mac.</string>

	<key>NSHumanReadableCopyright</key>
	<string>© 2026 Sam Bruggen</string>
</dict>
</plist>
